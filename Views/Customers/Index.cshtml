@model CrmApp.Models.Common.PagedResult<CrmApp.Models.DTOs.CustomerDto>

@{
    ViewData["Title"] = "Müşteriler";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Müşteriler</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Yeni Müşteri
        </a>
        <a asp-action="ImportExcel" class="btn btn-success shadow-sm ml-2">
            <i class="fas fa-file-excel fa-sm text-white-50"></i> Excel Yükle
        </a>
        <form asp-action="BulkInsert" method="post" class="d-inline ml-2">
             <button type="submit" class="btn btn-warning shadow-sm">
                <i class="fas fa-random fa-sm text-white-50"></i> Örnek Veri Üret
            </button>
        </form>
        <form asp-action="ResetDatabase" method="post" class="d-inline ml-2" onsubmit="return confirm('Tüm veriler silinecek ve ID sayaçları sıfırlanacak. Emin misiniz?');">
             <button type="submit" class="btn btn-danger shadow-sm">
                <i class="fas fa-trash-alt fa-sm text-white-50"></i> DB Sıfırla
            </button>
        </form>
    </div>
</div>

<!-- Pagination Controls -->
<div class="d-flex justify-content-between align-items-center mt-4">
    <div class="text-muted small">
        Toplam <strong>@Model.TotalCount</strong> kayıt, <strong>@Model.TotalPages</strong> sayfa. (Şu an: @Model.PageNumber)
    </div>
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm mb-0">
            @* Önceki Sayfa Butonu *@
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchTerm="@ViewBag.SearchTerm" title="İlk Sayfa">&laquo;</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchTerm="@ViewBag.SearchTerm" title="Önceki">&lsaquo;</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
                <li class="page-item disabled"><span class="page-link">&lsaquo;</span></li>
            }

            @{
                int startPage = Math.Max(1, Model.PageNumber - 2);
                int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);

                // Eğer toplam sayfa sayısı çok fazlaysa ve baştaysak, sonunu göstermek için aralığı kaydır
                if (Model.TotalPages > 5 && Model.PageNumber <= 3)
                {
                    endPage = Math.Min(5, Model.TotalPages);
                }
                
                // Eğer sondaysak, başını göstermek için aralığı kaydır
                if (Model.TotalPages > 5 && Model.PageNumber >= Model.TotalPages - 2)
                {
                    startPage = Math.Max(1, Model.TotalPages - 4);
                }
            }

            @* İlk sayfa her zaman görünsün mü? Opsiyonel. *@
            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchTerm="@ViewBag.SearchTerm">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-searchTerm="@ViewBag.SearchTerm">@Model.TotalPages</a>
                </li>
            }

            @* Sonraki Sayfa Butonu *@
            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchTerm="@ViewBag.SearchTerm" title="Sonraki">&rsaquo;</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-searchTerm="@ViewBag.SearchTerm" title="Son Sayfa">&raquo;</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">&rsaquo;</span></li>
                <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
            }
        </ul>
    </nav>
</div>

<!-- Bulk Delete Button (Hidden by default) -->
<div id="bulkDeleteContainer" class="mb-3" style="display: none;">
    <button id="btnBulkDelete" class="btn btn-danger">
        <i class="fas fa-trash"></i> Seçilenleri Sil
    </button>
    <span id="selectedCount" class="ml-2 text-muted"></span>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <div class="row align-items-center justify-content-between">
            <div class="col-md-6">
                <h6 class="m-0 font-weight-bold text-primary">Müşteri Listesi</h6>
            </div>
            <div class="col-md-6">
                <form asp-action="Index" method="get" class="d-flex justify-content-end">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control bg-light border-0 small" placeholder="Müşteri ara..." aria-label="Search" aria-describedby="basic-addon2" value="@ViewBag.SearchTerm">
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="button" onclick="this.form.submit()">
                                <i class="fas fa-search fa-sm"></i>
                            </button>
                            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                            {
                                <a asp-action="Index" class="btn btn-secondary ml-1" title="Filtreyi Temizle">
                                    <i class="fas fa-times"></i>
                                </a>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width: 40px;">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="selectAll">
                            </div>
                        </th>
                        <th>Sıra</th>
                        <th>Müşteri</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Toplam Tutar</th>
                        <th>Son İşlem</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNo = (Model.PageNumber - 1) * Model.PageSize; }
                    @foreach (var item in Model.Items)
                    {
                        rowNo++;
                        <tr>
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input customer-select" type="checkbox" value="@item.Id">
                                </div>
                            </td>
                            <td>
                                <span class="font-weight-bold">@rowNo</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="img-profile rounded-circle bg-gray-200 d-flex align-items-center justify-content-center mr-2" style="width: 35px; height: 35px; background-color: #eaecf4;">
                                        <span class="small font-weight-bold text-secondary">@item.FirstName.Substring(0,1)@item.LastName.Substring(0,1)</span>
                                    </div>
                                    <div>
                                        @item.FirstName @item.LastName
                                    </div>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.TotalPurchaseAmount.ToString("C2")</td>
                            <td>
                                @if(item.LastPurchaseDate.HasValue)
                                {
                                    <span>@item.LastPurchaseDate.Value.ToString("dd.MM.yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button onclick="deleteCustomer(@item.Id)" class="btn btn-danger btn-circle btn-sm" title="Sil">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Delete Customer
        function deleteCustomer(id) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu müşteriyi silmek istediğinize emin misiniz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                cancelButtonColor: '#858796',
                confirmButtonText: 'Evet, Sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Customers/Delete/' + id,
                        type: 'POST',
                        success: function(result) {
                            Swal.fire(
                                'Silindi!',
                                'Müşteri başarıyla silindi.',
                                'success'
                            ).then(() => {
                                location.reload();
                            });
                        },
                        error: function() {
                            Swal.fire(
                                'Hata!',
                                'Bir hata oluştu.',
                                'error'
                            );
                        }
                    });
                }
            })
        }

        $(document).ready(function() {
            // Select All Checkbox
            $("#selectAll").on('change', function() {
                $(".customer-select").prop('checked', $(this).prop('checked'));
                updateBulkDeleteButton();
            });

            // Individual Checkbox
            $(document).on('change', '.customer-select', function() {
                var allChecked = $(".customer-select:checked").length === $(".customer-select").length;
                $("#selectAll").prop('checked', allChecked);
                updateBulkDeleteButton();
            });

            function updateBulkDeleteButton() {
                var count = $(".customer-select:checked").length;
                if (count > 0) {
                    $("#bulkDeleteContainer").fadeIn();
                    $("#selectedCount").text(count + " seçili");
                } else {
                    $("#bulkDeleteContainer").fadeOut();
                }
            }

            // Bulk Delete Action
            $("#btnBulkDelete").on('click', function() {
                var selectedIds = $(".customer-select:checked").map(function() {
                    return parseInt($(this).val());
                }).get();

                if (selectedIds.length === 0) return;

                Swal.fire({
                    title: 'Toplu Silme',
                    text: `${selectedIds.length} adet müşteriyi silmek istediğinize emin misiniz?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e74a3b',
                    cancelButtonColor: '#858796',
                    confirmButtonText: 'Evet, Hepsini Sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Customers/BulkDelete',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(selectedIds),
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire('Silindi!', response.message, 'success').then(() => location.reload());
                                } else {
                                    Swal.fire('Hata!', response.message, 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Hata!', 'Sunucu hatası oluştu.', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
